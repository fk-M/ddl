{
  "name": "@ddl/desktop",
  "private": true,
  "version": "0.1.7",
  "productName": "DDL",
  "description": "截止日 - Windows 桌面端（Electron 外壳，内嵌本地服务与数据库）",
  "main": "electron/main.cjs",
  "author": "DDL",
  "scripts": {
    "prepare:res": "node scripts/prepare.mjs",
    "start": "npm run prepare:res && electron .",
    "dist": "npm run prepare:res && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run prepare:res && electron-builder --win --dir --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
