<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件的 2×2 四象限布局。
  RemoteViews 不支持动态列表，所以每个象限固定放 2 行任务，
  实际条数由 DdlWidgetProvider 按数据把多余的行设为 gone。

  象限顺序（按行铺）：重要紧急 / 重要不急 / 紧急不重 / 都不占，
  与前端 lib/widget.ts 的 QUADRANT_META 一一对应。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ddl_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ddl_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部：日期 + 计数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ddl_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="今天"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ddl_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 第一行：重要紧急 | 重要不急 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ddl_widget_cell"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="重要紧急"
                    android:textColor="#B91C1C"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ddl_q1_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ddl_q1_t1"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q1_t2"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q1_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="空了"
                android:textColor="#D4D4D4"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ddl_widget_cell"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="重要不急"
                    android:textColor="#1D4ED8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ddl_q2_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ddl_q2_t1"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q2_t2"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q2_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="空了"
                android:textColor="#D4D4D4"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第二行：紧急不重 | 都不占 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ddl_widget_cell"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="紧急不重"
                    android:textColor="#B45309"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ddl_q3_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ddl_q3_t1"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q3_t2"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q3_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="空了"
                android:textColor="#D4D4D4"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ddl_widget_cell"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="都不占"
                    android:textColor="#737373"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ddl_q4_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ddl_q4_t1"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q4_t2"
                style="@style/DdlWidgetTask"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ddl_q4_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="空了"
                android:textColor="#D4D4D4"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部：最近纪念日 -->
    <TextView
        android:id="@+id/ddl_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#D97706"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
