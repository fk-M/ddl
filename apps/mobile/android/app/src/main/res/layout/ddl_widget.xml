<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局。
  RemoteViews 不支持任意视图和动态列表，所以这里固定放 4 行，
  实际条数由 DdlWidgetProvider 按数据把多余的行设为 gone。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ddl_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ddl_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ddl_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="今天"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ddl_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 项"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ddl_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="今天清空了"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ddl_widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ddl_widget_dot" />

        <TextView
            android:id="@+id/ddl_widget_row1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1F2937"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ddl_widget_row1_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ddl_widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ddl_widget_dot" />

        <TextView
            android:id="@+id/ddl_widget_row2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1F2937"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ddl_widget_row2_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ddl_widget_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ddl_widget_dot" />

        <TextView
            android:id="@+id/ddl_widget_row3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1F2937"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ddl_widget_row3_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ddl_widget_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ddl_widget_dot" />

        <TextView
            android:id="@+id/ddl_widget_row4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1F2937"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ddl_widget_row4_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ddl_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#D97706"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
