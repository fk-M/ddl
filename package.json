{
  "name": "ddl-monorepo",
  "private": true,
  "version": "0.1.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @ddl/server",
    "dev:web": "npm run dev -w @ddl/web",
    "build": "npm run build -w @ddl/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @ddl/server",
    "serve:lan": "node scripts/serve-lan.mjs",
    "build:desktop": "npm run dist -w @ddl/desktop",
    "build:android": "npm run apk -w @ddl/mobile"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.1",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.12"
  }
}
