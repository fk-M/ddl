# 复制为 .env 后按需修改，真实密钥不要提交
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# PGlite 本地数据目录（相对 apps/server）
PGLITE_DIR=./data/pglite

# 允许的跨域来源，逗号分隔；生产环境禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 预留：切换到真实 Postgres 时填写，填写后优先使用
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/ddl

# 应用内更新：GitHub 仓库（owner/repo）。
# 客户端会读 https://api.github.com/repos/<owner>/<repo>/releases/latest 判断新版本。
# CI 构建时由 workflow 自动注入 GITHUB_REPOSITORY，本地开发留空即可（设置页会提示未配置更新源）。
# VITE_GITHUB_REPO=yourname/ddl

